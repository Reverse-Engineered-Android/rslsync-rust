<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="服务器设置"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="REST 服务器地址"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bearer token（可选）"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/save_client"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存客户端连接" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="服务器密码"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/exempt_ips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="免密 IP/CIDR，逗号分隔"
            android:inputType="text" />

        <Button
            android:id="@+id/login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="登录" />

        <Button
            android:id="@+id/save_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存服务器设置" />

        <Button
            android:id="@+id/clear_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清除服务器密码" />

        <Button
            android:id="@+id/logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="退出登录" />
    </LinearLayout>
</ScrollView>
